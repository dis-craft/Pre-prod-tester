      "diff": "diff --git a/.github/workflows/capture-and-publish.yml b/.github/workflows/capture-and-publish.yml\nindex 33b4093..306394c 100644\n--- a/.github/workflows/capture-and-publish.yml\n+++ b/.github/workflows/capture-and-publish.yml\n@@ -1,109 +1,109 @@\n name: Capture Changes and Publish\n \n on:\n   push:\n     branches: [main]\n     paths-ignore: ['data/**']\n   workflow_dispatch:\n \n permissions:\n   contents: write\n-  pull-requests: read\n+  pull-requests: write\n   pages: write\n   id-token: write\n   actions: read\n \n concurrency:\n   group: scan-data-publish\n   cancel-in-progress: false\n \n jobs:\n   capture-and-publish:\n     runs-on: ubuntu-latest\n     steps:\n       - name: Checkout full history\n         uses: actions/checkout@v4\n         with:\n           fetch-depth: 0\n \n       - name: Capture exact push diff\n         env:\n           GITHUB_EVENT_BEFORE: ${{ github.event.before }}\n           GITHUB_SHA: ${{ github.sha }}\n           GITHUB_EVENT_PATH: ${{ github.event_path }}\n           GITHUB_REPOSITORY: ${{ github.repository }}\n           GITHUB_SERVER_URL: ${{ github.server_url }}\n           GITHUB_REF_NAME: ${{ github.ref_name }}\n           GITHUB_RUN_ID: ${{ github.run_id }}\n         run: python3 scripts/capture-diff.py\n \n       - name: Run live security detection\n         id: security\n         uses: dis-craft/Pre-Prod-Orchestrator/.github/actions/security-engine@main\n         with:\n           scan-input: data/latest.json\n           scan-output: .preprod/baseline-scan\n           generate-remediation: \"false\"\n \n       - name: Attach findings to published scan\n         env:\n           FINDINGS: ${{ steps.security.outputs.findings }}\n         run: |\n           set -euo pipefail\n           test -n \"$FINDINGS\"\n           python3 scripts/attach-security-findings.py --scan data/latest.json --findings \"$FINDINGS\"\n \n-      - name: Build live flow state\n+      - name: Build live flow state before remediati