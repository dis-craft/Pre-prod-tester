          "new_line": 2,
          "content": ""
        },
        {
          "type": "added",
          "new_line": 3,
          "content": "Pre-prod Tester is integrated as a GitHub Actions reusable workflow. It is not an npm dependency because the first-stage operation is Git-aware: it needs the caller repository's commit history and the exact before -> after push range."
        },
        {
          "type": "added",
          "new_line": 4,
          "content": ""
        },
        {
          "type": "added",
          "new_line": 5,
          "content": "## Add it to another repository"
