          "type": "added",
          "new_line": 23,
          "content": ""
        },
        {
          "type": "added",
          "new_line": 24,
          "content": "The reusable workflow checks out the calling repository, captures the exact Git diff, and uploads a machine-readable artifact."
        },
        {
          "type": "added",
          "new_line": 25,
          "content": ""
        },
        {
          "type": "added",
          "new_line": 26,
