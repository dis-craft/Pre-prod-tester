            "new_line": 25,
            "content": "    parser = argparse.ArgumentParser()"
          },
          {
            "type": "added",
            "new_line": 26,
            "content": "    parser.add_argument(\"--input\", required=True, help=\"Scanner findings/report JSON\")"
          },
          {
            "type": "added",
            "new_line": 27,
            "content": "    parser.add_argument(\"--output\", default=\".preprod/remediation-request.json\")"
          },
          {
            "type": "added",
            "new_line": 28,
            "content": "    parser.add_argument(\"--repository\", default=os.environ.get(\"GITHUB_REPOSITORY\", \"\"))"
          },
          {
            "type": "added",
            "new_line": 29,
            "content": "    parser.add_argument(\"--commit\", default=os.environ.get(\"GITHUB_SHA\", \"\"))"
          },
          {
            "type": "added",
            "new_line": 30,
            "content": "    parser.add_argument(\"--ref\", default=os.environ.get(\"GITHUB_REF_NAME\", \"\"))"
          },
          {
            "type": "added",
            "new_line": 31,
            "content": "    parser.add_argument(\"--pull-request\", default=os.environ.get(\"PR_NUMBER\", \"\"))"
          },
          {
            "type": "added",
            "new_line": 32,
            "content": "    parser.add_argument(\"--generate\", action=\"store_true\", help=\"Request remediation generation\")"
          },
          {
            "type": "added",
            "new_line": 33,
            "content": "    args = parser.parse_args()"
          },
          {
            "type": "added",
            "new_line": 34,
            "content": ""
          },
          {
            "type": "added",
            "new_line": 35,
            "content": "    source = load_json(args.input)"
          },
          {
            "type": "added",
            "new_line": 36,
            "content": "    findings = source.get(\"findings\", [])"
          },
          {
            "type": "added",
            "new_line": 37,
            "content": "    if not findings and isinstance(source.get(\"result\"), dict):"
          },
          {
            "type": "added",
