flow.json .pages/data/flow.json\n           else\n             printf '{\"schema_version\":\"1.1\",\"current_stage_label\":\"Waiting\",\"stages\":[]}\n ' > .pages/data/flow.json\n           fi\n \n           if [ -f .runtime-prs.json ]; then\n             cp .runtime-prs.json .pages/data/pull-requests.json\n           else\n             printf '[]\n ' > .pages/data/pull-requests.json\n           fi\n \n           cat > .pages/deployment.json <<EOF\n           {\n             \"deployed_commit\": \"${{ github.sha }}\",\n             \"deployed_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\n             \"workflow_run\": \"${{ github.run_id }}\"\n           }\n           EOF\n \n       - name: Configure GitHub Pages\n         uses: actions/configure-pages@v5\n \n       - name: Upload Pages artifact\n         uses: actions/upload-pages-artifact@v4\n         with:\n           path: .pages\n \n       - name: Deploy to GitHub Pages\n         id: deployment\n         uses: actions/deploy-pages@v4\n",
