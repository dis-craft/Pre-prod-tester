      "diff": "diff --git a/.github/workflows/capture-and-publish.yml b/.github/workflows/capture-and-publish.yml\nindex a9accc1..2547d72 100644\n--- a/.github/workflows/capture-and-publish.yml\n+++ b/.github/workflows/capture-and-publish.yml\n@@ -1,92 +1,93 @@\n name: Capture Changes and Publish\n \n on:\n   push:\n     branches:\n       - main\n     paths-ignore:\n       - 'data/**'\n   workflow_dispatch:\n \n permissions:\n   contents: write\n+  pull-requests: read\n   pages: write\n   id-token: write\n \n concurrency:\n   group: pages\n   cancel-in-progress: false\n \n jobs:\n   capture-and-publish:\n     runs-on: ubuntu-latest\n     environment:\n       name: github-pages\n       url: ${{ steps.deployment.outputs.page_url }}\n \n     steps:\n       - name: Checkout full history\n         uses: actions/checkout@v4\n         with:\n           fetch-depth: 0\n \n       - name: Capture exact push diff\n         env:\n           GITHUB_EVENT_BEFORE: ${{ github.event.before }}\n           GITHUB_SHA: ${{ github.sha }}\n           GITHUB_EVENT_PATH: ${{ github.event_path }}\n           GITHUB_REPOSITORY: ${{ github.repository }}\n           GITHUB_SERVER_URL: ${{ github.server_url }}\n           GITHUB_REF_NAME: ${{ github.ref_name }}\n           GITHUB_RUN_ID: ${{ github.run_id }}\n         run: python3 scripts/capture-diff.py\n \n       - name: Run live security detection\n         id: security\n         uses: dis-craft/Pre-Prod-Orchestrator/.github/actions/security-engine@main\n         with:\n           scan-input: data/latest.json\n           scan-output: .preprod/baseline-scan\n           generate-remediation: \"false\"\n \n       - name: Attach findings to published scan\n         env:\n           FINDINGS: ${{ steps.security.outputs.findings }}\n         run: |\n           set -euo pipefail\n           test -n \"$FINDINGS\"\n           python3 scripts/attach-security-findings.py --scan data/latest.json --findings \"$FINDINGS\"\n       - name: Attach live remediation PR state\n         env:\n           GH_TOKEN: ${{ github.token }}\n           GITHUB_REPOSITORY: ${{ github.repository }}\n         run: |\n           set -euo pipefail\n           python3 - <<'PY'\n           import json, os, urllib.request\n           from pathlib import Path\n \n           repo = os.environ[\"GITHUB_REPOSITORY\"]\n           token = os.environ[\"GH_TOKEN\"]\n           req = urllib.request.Request(\n               f\"https://api.github.com/repos/{repo}/pulls?state=all&per_page=30&sort=updated&direction=desc\",\n               headers={\n                   \"Accept\": \"application/vnd.github+json\",\n                   \"Authorization\": f\"Bearer {token}\",\n                   \"X-GitHub-Api-Version\": \"2022-11-28\",\n               },\n           )\n           with urllib.request.urlopen(req, timeout=30) as response:\n               prs = json.load(response)\n \n           remediation_prs = []\n           for pr in prs:\n               head = pr.get(\"head\", {}).get(\"ref\", \"\")\n               if not head.startswith(\"security-remediation/\"):\n                   continue\n               remediation_prs.append({\n                   \"number\": pr.get(\"number\"),\n                   \"title\": pr.get(\"title\"),\n                   \"state\": pr.get(\"state\"),\n                   \"merged\": pr.get(\"merged_at\") is not None,\n                   \"head\": head,\n",
