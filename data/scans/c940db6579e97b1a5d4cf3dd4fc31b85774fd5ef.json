ata/scans\n           cp index.html .pages/index.html\n           cp data/latest.json .pages/data/latest.json\n           cp data/index.json .pages/data/index.json\n           cp -R data/scans/. .pages/data/scans/\n \n           cat > .pages/deployment.json <<EOF\n           {\n             \"deployed_commit\": \"${{ github.sha }}\",\n             \"deployed_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\n             \"workflow_run\": \"${{ github.run_id }}\"\n           }\n           EOF\n \n           echo \"Pages payload:\"\n           find .pages -type f -maxdepth 4 -print\n           echo \"Latest scan:\"\n           python3 -m json.tool .pages/data/latest.json | head -80\n \n       - name: Configure GitHub Pages\n         uses: actions/configure-pages@v5\n \n       - name: Upload Pages artifact\n         uses: actions/upload-pages-artifact@v4\n         with:\n           path: .pages\n \n       - name: Deploy to GitHub Pages\n         id: deployment\n         uses: actions/deploy-pages@v4\n",
