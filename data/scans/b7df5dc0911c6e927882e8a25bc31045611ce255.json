      "diff": "diff --git a/.github/workflows/capture-and-publish.yml b/.github/workflows/capture-and-publish.yml\nindex ffdfac4..62f2665 100644\n--- a/.github/workflows/capture-and-publish.yml\n+++ b/.github/workflows/capture-and-publish.yml\n@@ -1,88 +1,103 @@\n name: Capture Changes and Publish\n \n on:\n   push:\n     branches:\n       - main\n     paths-ignore:\n       - 'data/**'\n   workflow_dispatch:\n \n permissions:\n   contents: write\n   pages: write\n   id-token: write\n \n concurrency:\n   group: pages\n   cancel-in-progress: false\n \n jobs:\n   capture-and-publish:\n     runs-on: ubuntu-latest\n     environment:\n       name: github-pages\n       url: ${{ steps.deployment.outputs.page_url }}\n \n     steps:\n       - name: Checkout full history\n         uses: actions/checkout@v4\n         with:\n           fetch-depth: 0\n \n       - name: Capture exact push diff\n         env:\n           GITHUB_EVENT_BEFORE: ${{ github.event.before }}\n           GITHUB_SHA: ${{ github.sha }}\n           GITHUB_EVENT_PATH: ${{ github.event_path }}\n           GITHUB_REPOSITORY: ${{ github.repository }}\n           GITHUB_SERVER_URL: ${{ github.server_url }}\n           GITHUB_REF_NAME: ${{ github.ref_name }}\n           GITHUB_RUN_ID: ${{ github.run_id }}\n         run: python3 scripts/capture-diff.py\n \n+      - name: Run live security detection\n+        id: security\n+        uses: dis-craft/Pre-Prod-Orchestrator/.github/actions/security-engine@Adi-initial\n+        with:\n+          scan-input: data/latest.json\n+          scan-output: .preprod/baseline-scan\n+          generate-remediation: \"false\"\n+\n+      - name: Attach findings to published scan\n+        env:\n+          FINDINGS: ${{ steps.security.outputs.findings }}\n+        run: |\n+          set -euo pipefail\n+          test -n \"$FINDINGS\"\n+          python3 scripts/attach-security-findings.py --scan data/latest.json --findings \"$FINDINGS\"\n       - name: Persist generated scan data\n         run: |\n           git config user.name \"github-actions[bot]\"\n           git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n           git add data/latest.json data/index.json data/scans/\n           if git diff --cached --quiet; then\n             echo \"No generated data changes to commit.\"\n           else\n             git commit -m \"chore: publish scan data [skip ci]\"\n             git push origin HEAD:\"$GITHUB_REF_NAME\"\n           fi\n \n       - name: Build isolated Pages site\n         run: |\n           rm -rf .pages\n           mkdir -p .pages/data/scans\n           cp index.html .pages/index.html\n           cp data/latest.json .pages/data/latest.json\n           cp data/index.json .pages/data/index.json\n           cp -R data/scans/. .pages/data/scans/\n \n           cat > .pages/deployment.json <<EOF\n           {\n             \"deployed_commit\": \"${{ github.sha }}\",\n             \"deployed_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\n             \"workflow_run\": \"${{ github.run_id }}\"\n           }\n           EOF\n \n           echo \"Pages payload:\"\n           find .pages -type f -maxdepth 4 -print\n           echo \"Latest scan:\"\n           python3 -m json.tool .pages/data/latest.json | head -80\n \n       - name: Configure GitHub Pages\n         uses: actions/configure-pages@v5\n \n       - name: Upload Pages artifact\n         uses: actions/upload-pages-artifact@v4\n         with:\n           path: .pages\n \n       - name: Deploy to GitHub Pages\n         id: deployment\n         uses: actions/deploy-pages@v4\n",
